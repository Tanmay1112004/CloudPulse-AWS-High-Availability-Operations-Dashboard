#!/bin/bash
set -Eeuo pipefail
exec > >(tee -a /var/log/cloud-init-output.log | logger -t user-data -s 2>/dev/console) 2>&1

dnf update -y
dnf install -y python3 python3-boto3 unzip awscli amazon-cloudwatch-agent

APP_DIR="/opt/cloudpulse"
mkdir -p "$APP_DIR"
aws s3 cp "s3://${bucket_name}/${object_key}" /tmp/app-bundle.zip --region "${aws_region}"
unzip -o /tmp/app-bundle.zip -d "$APP_DIR"
chown -R ec2-user:ec2-user "$APP_DIR"

cat > /etc/systemd/system/cloudpulse.service <<'SERVICE'
[Unit]
Description=CloudPulse AWS operations dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/cloudpulse
Environment=PORT=8080
Environment=AWS_REGION=${aws_region}
Environment=COUNTER_FUNCTION_NAME=${counter_function}
Environment=APP_BUILD_VERSION=${build_version}
ExecStart=/usr/bin/python3 /opt/cloudpulse/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
SERVICE

cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'CWCONFIG'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/cloud-init-output.log",
            "log_group_name": "/${project_name}/bootstrap",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
CWCONFIG

systemctl daemon-reload
systemctl enable --now cloudpulse
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s || true
